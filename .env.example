# ── BharatCode API ─────────────────────────────────────────────
# Copy to .env and fill real values. NEVER commit .env.
# If a key has been exposed (chat, screenshot, commit), ROTATE it first.

# Required: BharatCode API key
BHARATCODE_API_KEY=your_key_here

# Required: BharatCode API base URL (confirm from their docs)
BHARATCODE_BASE_URL=https://api.bharatcode.ai/v1

# Required: model for explain + quiz steps (confirm from their docs)
BHARATCODE_MODEL=qwen-3.8-27b

# Optional: request timeout in ms (Qwen 3.8 27B can be slow — 90s recommended)
BHARATCODE_TIMEOUT_MS=90000